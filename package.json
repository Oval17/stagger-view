{
  "name": "staggered-image-loader",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "npm run build-sw && webpack --mode production && npm run copy-assets",
    "build-sw": "webpack --config webpack.sw.config.js --mode production",
    "build-dev": "npm run build-sw && webpack --mode development && npm run copy-assets",
    "lint": "eslint . --ext .ts,.tsx",
    "preview": "serve dist",
    "clean": "rm -rf dist public/service-worker.js",
    "copy-assets": "node scripts/copy-assets.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.22.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-loader": "^9.1.0",
    "css-loader": "^6.8.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.5.0",
    "style-loader": "^3.3.0",
    "typescript": "^5.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  }
}
